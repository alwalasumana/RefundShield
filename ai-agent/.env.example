# RefundShield AI Agent — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Select LLM Provider: 'gemini' or 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Key (free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/refundshield

# ── Official Razorpay MCP Integration (Read-Only) ────────────────────────────
# Obtain test credentials from: https://dashboard.razorpay.com/app/keys
# Use keys starting with rzp_test_ for the Buildathon demo.
# If not configured, Razorpay MCP is skipped gracefully and investigations
# continue using RefundShield's internal fraud-network intelligence only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
